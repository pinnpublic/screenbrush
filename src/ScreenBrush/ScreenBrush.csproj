<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ScreenBrush.ico</ApplicationIcon>
    <AssemblyName>ScreenBrush</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/ScreenBrush.ico" LogicalName="ScreenBrush.AppIcon.ico" />
    <EmbeddedResource Include="Assets/Whiteboard/*.png" LogicalName="ScreenBrush.Board.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
